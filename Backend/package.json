        "cors": "^2.8.6",
        "dotenv": "^18.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "hpp": "^0.2.3",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.1"
    },
    "devDependencies": {
