    "main": "dist/server.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "tsc",
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:seed": "tsx src/db/seed.ts",
        "db:reset": "tsx src/db/reset.ts",
        "db:generate": "typeorm migration:generate -d src/config/data-source.ts src/db/migrations/Auto",
        "db:revert": "typeorm migration:revert -d src/config/data-source.ts",
        "typeorm": "typeorm"
    },
