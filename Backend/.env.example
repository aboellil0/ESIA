# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esia_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=esia_db
PGUSER=postgres
PGPASSWORD=postgres

# CORS
FRONTEND_URL=http://localhost:3000

# Auth (Basira-style)
JWT_SECRET=change_me_esia_jwt_secret_2026
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_SECRET=change_me_esia_access_secret_2026_very_long_random_key_32chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
BCRYPT_ROUNDS=12