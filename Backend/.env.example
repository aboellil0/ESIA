# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esia_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=esia_db
PGUSER=postgres
PGPASSWORD=postgres

# CORS
FRONTEND_URL=http://localhost:3000

# Auth (Basira-style)
JWT_SECRET=change_me_esia_jwt_secret_2026
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_SECRET=change_me_esia_access_secret_2026_very_long_random_key_32chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
BCRYPT_ROUNDS=12

# Email verification (Brevo transactional email)
# Get your key from https://app.brevo.com/settings/keys/api-keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@esia.shop
BREVO_SENDER_NAME=ESIA
# Must be a verified sender in Brevo. Verification link points to $FRONTEND_URL/verify-email?token=...
EMAIL_VERIFICATION_EXPIRES_HOURS=24
# Password reset link points to $FRONTEND_URL/reset-password?token=...
PASSWORD_RESET_EXPIRES_MINUTES=60