# Browser-facing API base. Use /api when Vite or nginx proxies API requests.
VITE_API_BASE_URL=/api

# Vite development proxy target must be the backend origin, without /api.
VITE_API_PROXY_TARGET=http://localhost:5000

# Optional checkout transfer instructions supplied by the store owner.
VITE_TRANSFER_NUMBER=
VITE_TRANSFER_ACCOUNT_NAME=
