# PostgreSQL - PRODUCTION
POSTGRES_USER=esia_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=esia_db

# Backend
DATABASE_URL=postgresql://esia_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/esia_db
FRONTEND_URL=https://esia.com,https://www.esia.com

# Frontend (Vite)
VITE_API_BASE_URL=https://esia.com/api

# Deployment - replace with real domain & email
DOMAIN=esia.com
CERTBOT_EMAIL=admin@esia.com

# Email verification (Brevo) - set real values in production
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@esia.com
BREVO_SENDER_NAME=ESIA
EMAIL_VERIFICATION_EXPIRES_HOURS=24
