# PostgreSQL
POSTGRES_USER=esia_admin
POSTGRES_PASSWORD=superStrongPassword123
POSTGRES_DB=esia_db

# Backend
DATABASE_URL=postgresql://esia_admin:superStrongPassword123@postgres:5432/esia_db
FRONTEND_URL=http://localhost,http://localhost:80,http://esia.local

# Frontend (Vite - NOT NextAuth)
VITE_API_BASE_URL=http://localhost/api

# Deployment
DOMAIN=esia.local
CERTBOT_EMAIL=admin@esia.local

# Email verification (Brevo transactional email)
# Get your key from https://app.brevo.com/settings/keys/api-keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@esia.shop
BREVO_SENDER_NAME=ESIA
EMAIL_VERIFICATION_EXPIRES_HOURS=24
